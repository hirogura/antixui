#!/bin/sh
### BEGIN INIT INFO
# Provides:          antixui
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: antix-UI web server management interface
# Description:       FastAPI/uvicorn based server management UI (antiX/sysVinit)
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DESC="antix-UI"
NAME=antixui
APP_DIR="/opt/antix-ui"
DAEMON="$APP_DIR/venv/bin/python"
DAEMON_ARGS="-m uvicorn main:app --host 127.0.0.1 --port 3355"
PIDFILE=/run/antixui.pid

[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

do_start()
{
    start-stop-daemon --start --pidfile "$PIDFILE" --make-pidfile \
        --background --chdir "$APP_DIR" \
        --startas "$DAEMON" --output /var/log/antixui.log -- $DAEMON_ARGS
    return $?
}

do_stop()
{
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry=TERM/5/KILL/5
    rm -f "$PIDFILE"
    return $?
}

case "$1" in
  start)
    log_daemon_msg "Starting $DESC" "$NAME"
    do_start
    log_end_msg $?
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    do_stop
    log_end_msg $?
    ;;
  restart|force-reload)
    do_stop
    sleep 1
    do_start
    ;;
  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" && exit 0 || exit $?
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 3
    ;;
esac
