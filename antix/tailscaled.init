#!/bin/sh
### BEGIN INIT INFO
# Provides:          tailscaled
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Tailscale node agent
# Description:       tailscaled daemon for antiX (sysVinit)
### END INIT INFO

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
DESC="Tailscale node agent"
NAME=tailscaled
DAEMON=/usr/sbin/tailscaled
PIDFILE=/run/tailscaled.pid
LOGFILE=/var/log/tailscaled.log
DAEMON_ARGS="--state=/var/lib/tailscale/tailscaled.state --socket=/run/tailscale/tailscaled.sock"

[ -x "$DAEMON" ] || exit 0

. /lib/lsb/init-functions

do_start()
{
    mkdir -p /var/lib/tailscale /run/tailscale
    start-stop-daemon --start --pidfile "$PIDFILE" --make-pidfile \
        --background --startas "$DAEMON" \
        --output "$LOGFILE" -- $DAEMON_ARGS
    # ソケットができるまで少し待つ
    i=0
    while [ $i -lt 20 ]; do
        [ -S /run/tailscale/tailscaled.sock ] && return 0
        sleep 0.5
        i=$((i+1))
    done
    return 0
}

do_stop()
{
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry=TERM/5/KILL/5
    rm -f "$PIDFILE"
    return $?
}

case "$1" in
  start)
    log_daemon_msg "Starting $DESC" "$NAME"
    do_start
    log_end_msg $?
    ;;
  stop)
    log_daemon_msg "Stopping $DESC" "$NAME"
    do_stop
    log_end_msg $?
    ;;
  restart|force-reload)
    do_stop
    sleep 1
    do_start
    ;;
  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" && exit 0 || exit $?
    ;;
  *)
    echo "Usage: /etc/init.d/tailscaled {start|stop|restart|status}" >&2
    exit 3
    ;;
esac
